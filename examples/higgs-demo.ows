<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="orange3-cloud: HIGGS demo" description="Cross-validates a random forest and logistic regression on all 11 million rows of the HIGGS dataset on a cloud machine and shows their ROC curves. The machine downloads the data from the UCI Machine Learning Repository itself. Start a Medium machine with Cloud settings first.">
	<nodes>
		<node id="0" name="Cloud File" qualified_name="orangecontrib.cloud.widgets.owcloudfile.OWCloudFile" project_name="orange3-cloud" version="" title="Cloud File" position="(100, 110)" />
		<node id="1" name="Random Forest" qualified_name="Orange.widgets.model.owrandomforest.OWRandomForest" project_name="Orange3" version="" title="Random Forest" position="(260, 40)" />
		<node id="2" name="Logistic Regression" qualified_name="Orange.widgets.model.owlogisticregression.OWLogisticRegression" project_name="Orange3" version="" title="Logistic Regression" position="(260, 190)" />
		<node id="3" name="Cloud Test &amp; Score" qualified_name="orangecontrib.cloud.widgets.owcloudtestandscore.OWCloudTestAndScore" project_name="orange3-cloud" version="" title="Cloud Test &amp; Score" position="(430, 110)" />
		<node id="4" name="ROC Analysis" qualified_name="Orange.widgets.evaluate.owrocanalysis.OWROCAnalysis" project_name="Orange3" version="" title="ROC Analysis" position="(600, 110)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="3" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="train_data" />
		<link id="1" source_node_id="1" sink_node_id="3" source_channel="Learner" sink_channel="Learner" enabled="true" source_channel_id="learner" sink_channel_id="learner" />
		<link id="2" source_node_id="2" sink_node_id="3" source_channel="Learner" sink_channel="Learner" enabled="true" source_channel_id="learner" sink_channel_id="learner" />
		<link id="3" source_node_id="3" sink_node_id="4" source_channel="Evaluation Results" sink_channel="Evaluation Results" enabled="true" source_channel_id="evaluations_results" sink_channel_id="evaluation_results" />
	</links>
	<annotations>
		<text id="0" type="text/plain" rect="(30.0, 270.0, 700.0, 110.0)">Start a machine first: Cloud settings… in any Cloud widget, Google Cloud, size Medium (n2-standard-16) or larger. Cloud File then makes the machine download HIGGS.csv.gz (2.6 GB, 11,000,000 rows, 28 features) from the UCI Machine Learning Repository; nothing goes through this computer. The file has no header row, so the columns are called Feature 1 to Feature 29; Feature 1 is the class (1 = signal, 0 = background). Cloud Test &amp; Score runs 5-fold cross-validation on all rows on the machine. The evaluation results (about 0.7 GB) come back for ROC Analysis after you agree to download them.</text>
	</annotations>
