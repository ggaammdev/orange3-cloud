<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="orange3-cloud: local demo" description="Cross-validates a random forest and logistic regression on 1M rows on the cloud machine and shows their ROC curves; trains logistic regression on the machine and predicts all rows there. Make the data first with scripts/make-demo-data.py, and start the machine with Cloud settings.">
	<nodes>
		<node id="0" name="Cloud File" qualified_name="orangecontrib.cloud.widgets.owcloudfile.OWCloudFile" project_name="orange3-cloud" version="" title="Cloud File" position="(100, 300)" />
		<node id="1" name="Random Forest" qualified_name="Orange.widgets.model.owrandomforest.OWRandomForest" project_name="Orange3" version="" title="Random Forest" position="(260, 40)" />
		<node id="2" name="Logistic Regression" qualified_name="Orange.widgets.model.owlogisticregression.OWLogisticRegression" project_name="Orange3" version="" title="Logistic Regression" position="(260, 170)" />
		<node id="3" name="Cloud Test &amp; Score" qualified_name="orangecontrib.cloud.widgets.owcloudtestandscore.OWCloudTestAndScore" project_name="orange3-cloud" version="" title="Cloud Test &amp; Score" position="(430, 110)" />
		<node id="4" name="ROC Analysis" qualified_name="Orange.widgets.evaluate.owrocanalysis.OWROCAnalysis" project_name="Orange3" version="" title="ROC Analysis" position="(600, 110)" />
		<node id="5" name="Cloud Learner" qualified_name="orangecontrib.cloud.widgets.owcloudlearner.OWCloudLearner" project_name="orange3-cloud" version="" title="Cloud Learner" position="(430, 300)" />
		<node id="6" name="Cloud Predictions" qualified_name="orangecontrib.cloud.widgets.owcloudpredictions.OWCloudPredictions" project_name="orange3-cloud" version="" title="Cloud Predictions" position="(600, 300)" />
		<node id="7" name="Cloud Data Table" qualified_name="orangecontrib.cloud.widgets.owclouddatatable.OWCloudDataTable" project_name="orange3-cloud" version="" title="Cloud Data Table" position="(770, 300)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="3" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="train_data" />
		<link id="1" source_node_id="1" sink_node_id="3" source_channel="Learner" sink_channel="Learner" enabled="true" source_channel_id="learner" sink_channel_id="learner" />
